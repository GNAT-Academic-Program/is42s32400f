with "config/is42s32400f_tests_config.gpr";
with "config/is42s32400f_tests_list_config.gpr";

project Is42s32400f_Tests is
   for Source_Dirs use ("src/**", "common/", "config/");
   for Object_Dir use "obj/" & Is42s32400f_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use Is42s32400f_Tests_List_Config.Test_Files;

   package Compiler is
      for Default_Switches ("Ada") use
        Is42s32400f_Tests_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;
end Is42s32400f_Tests;
